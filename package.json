{
	"name": "domus",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "dotenv -c -- turbo build",
		"db:generate": "pnpm --filter @domus/scripts db:generate",
		"dev": "dotenv -c -- turbo dev",
		"start": "pnpm run dev",
		"lint": "oxlint && depcruise --config .dependency-cruiser.cjs apps packages modules",
		"lint:fix": "oxlint --fix",
		"clean": "turbo clean",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"type-check": "dotenv -c -- turbo type-check",
		"test": "dotenv -c -- turbo test",
		"prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
	},
	"devDependencies": {
		"@domus/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"dependency-cruiser": "catalog:",
		"dotenv-cli": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.4.2"
}
