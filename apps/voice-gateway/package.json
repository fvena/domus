{
	"name": "@domus/voice-gateway",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsx watch src/main.ts",
		"start": "node dist/main.mjs",
		"build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/main.mjs",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@domus/api-client": "workspace:*",
		"@domus/platform": "workspace:*",
		"@domus/utils": "workspace:*",
		"@hono/node-server": "catalog:",
		"hono": "catalog:"
	},
	"devDependencies": {
		"@domus/test-utils": "workspace:*",
		"@domus/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"esbuild": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
