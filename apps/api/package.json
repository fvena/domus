{
	"name": "@domus/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsx watch src/dev.ts",
		"start": "node dist/main.mjs",
		"build": "esbuild src/main.ts src/accounts.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --sourcemap --outdir=dist --out-extension:.js=.mjs",
		"accounts": "tsx --import ./src/dev-env.ts src/accounts.ts",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@domus/platform": "workspace:*",
		"@domus/utils": "workspace:*",
		"@hono/node-server": "catalog:",
		"better-sqlite3": "catalog:",
		"hono": "catalog:"
	},
	"devDependencies": {
		"@domus/test-utils": "workspace:*",
		"@domus/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"esbuild": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
