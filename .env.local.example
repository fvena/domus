# Copy to .env.local for development. `pnpm dev` loads it through dotenv-cli.

# Where assistant and voice-gateway reach the api.
DOMUS_API_URL=http://localhost:3000

# Where the api keeps domus.db: an absolute path. Unset, `pnpm dev` uses <repo>/data.
# DOMUS_DATA_DIR=/absolute/path/to/data

# How the api signs sessions, and the origins the app is served from. Unset, `pnpm dev` uses a
# development-only secret and http://localhost:5173,http://localhost:3000.
# DOMUS_AUTH_SECRET=
# DOMUS_ORIGINS=http://localhost:5173,http://localhost:3000
