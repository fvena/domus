#!/bin/sh
# Runs before every commit: the same lint, format and type checks as CI. Tests stay in CI.
# Skip once with `git commit --no-verify`, only when you know why.
set -e

if command -v pnpm >/dev/null 2>&1; then
	run() { pnpm "$@"; }
else
	# No pnpm on PATH (Node without corepack): use the version package.json pins.
	version=$(node -p "require('./package.json').packageManager.split('@')[1]")
	run() { npx -y "pnpm@$version" "$@"; }
fi

run lint
run format:check
run type-check
