{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": [
		"modules/*/server/migrations/",
		"tooling/scripts/fixtures/migrations/*/meta/",
		".trail/"
	],
	"arrowParens": "always",
	"printWidth": 100,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"semi": true,
	"trailingComma": "all",
	"vueIndentScriptAndStyle": true,
	"sortImports": {
		"groups": [
			"builtin",
			"external",
			["internal", "subpath"],
			["parent", "sibling", "index"],
			"style",
			"unknown"
		]
	},
	"sortPackageJson": true
}
